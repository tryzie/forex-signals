<?xml version="1.0" encoding="UTF-8"?>
<!--
  Symbol catalogue (CLAUDE.md "User decisions", PLAN §2). Not secret; committed.

  role       SIGNAL (strategies may trade it) | CONTEXT (read only, never traded) | DATA_ONLY (inputs to derived series)
  class      FX | METAL | INDEX     hours: trading-hours profile used for stale detection and the gap report
  digits     default price digits; the feed's own spec overrides it at startup
  cluster    exposure cluster (XAU and XAG form METALS)
  <feed>     broker symbol name per feed; required="true" = the app refuses to start if it is missing there.
             Symbols missing on a feed are optional there (CLAUDE.md).
  USDX stays CONTEXT and verified="false" until its contract specs and trading hours are checked by hand.
-->
<symbols>
  <symbol code="EURUSD" role="SIGNAL" class="FX" base="EUR" quote="USD" digits="5" hours="FX">
    <feed name="ctrader" symbol="EURUSD" required="true"/>
    <feed name="deriv" symbol="frxEURUSD" required="true"/>
  </symbol>
  <symbol code="GBPUSD" role="SIGNAL" class="FX" base="GBP" quote="USD" digits="5" hours="FX">
